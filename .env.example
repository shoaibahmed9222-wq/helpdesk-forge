DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
# openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# local (default) or openai. Both write 384-dimensional vectors.
EMBEDDING_PROVIDER=local
# Embeddings when EMBEDDING_PROVIDER=openai. Also the hosted answer-model key
# when LLM_API_KEY is unset.
OPENAI_API_KEY=

# Encrypts workspace model keys. Falls back to AUTH_SECRET when unset.
APP_SECRET=

# Hosted answer model, used when a workspace has not saved its own key.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional. Set for Groq, Together, OpenRouter, or a local OpenAI-compatible server.
# LLM_BASE_URL=https://api.groq.com/openai/v1
