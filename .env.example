DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
# openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# local (default, development only), openai, or compatible.
# Production refuses to start on local: the model would download weights on every cold start.
# Hosted endpoints must return 384-dimensional vectors. See README for a different width.
EMBEDDING_PROVIDER=local
# Required for EMBEDDING_PROVIDER=compatible. openai defaults to https://api.openai.com/v1.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# Secret. Falls back to OPENAI_API_KEY when unset.
EMBEDDING_API_KEY=
# openai defaults to text-embedding-3-small. Required for compatible.
EMBEDDING_MODEL=
# Set to true to send dimensions=384 to a non-OpenAI endpoint that supports it.
# EMBEDDING_SEND_DIMENSIONS=true

# Embeddings fallback when EMBEDDING_API_KEY is unset. Also the hosted answer-model
# key when LLM_API_KEY is unset.
OPENAI_API_KEY=

# Encrypts workspace model keys. Required in production. In development, AUTH_SECRET is used when this is unset.
APP_SECRET=

# Hosted answer model, used when a workspace has not saved its own key.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional. Set for Groq, Together, OpenRouter, or a local OpenAI-compatible server.
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Inbound address is <workspace-slug>@INBOUND_DOMAIN.
INBOUND_DOMAIN=inbound.localhost
# Shared secret for POST /api/email/inbound. Bearer token, or the HTTP Basic password.
INBOUND_WEBHOOK_SECRET=replace-with-a-long-random-secret

# SMTP for sign-in links and replies. Required in production.
# Mailpit in docker compose listens on 1025 and needs no auth.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# From address for sign-in mail. Required in production.
EMAIL_FROM=Helpdesk Forge <noreply@localhost>

# Optional. Website chat requests per public key and IP each minute. Default 20.
# Stored in Postgres, so the limit holds across app instances.
# WIDGET_RATE_LIMIT=20
